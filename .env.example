# ============================================================
#  CINE BOT — Настройка окружения
# ============================================================
#  Скопируйте этот файл:  cp .env.example .env
#  Заполните все поля ниже реальными значениями.
# ============================================================


# ------------------------------------------------------------
#  1. TELEGRAM USER API (Userbot — слушает каналы-источники)
# ------------------------------------------------------------
#  Зачем: Telegram не даёт ботам читать каналы, на которые они
#         не добавлены. Userbot работает от имени вашего аккаунта
#         и может слушать любые публичные каналы.
#
#  Как получить:
#    1. Откройте https://my.telegram.org и войдите по номеру телефона
#    2. Перейдите в «API development tools»
#    3. Заполните форму (App title и Short name — любые)
#    4. Нажмите «Create application»
#    5. Скопируйте App api_id → API_ID, App api_hash → API_HASH
#
#  Важно: при первом запуске бота Telethon попросит ввести
#  код из Telegram для авторизации. После этого создастся файл
#  userbot.session — повторная авторизация не потребуется.

API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef


# ------------------------------------------------------------
#  2. TELEGRAM BOT TOKEN (Бот — отправляет сообщения в канал)
# ------------------------------------------------------------
#  Зачем: отдельный бот-аккаунт для публикации сообщений
#         в целевой канал. Бот должен быть админом канала.
#
#  Как получить:
#    1. Откройте Telegram, найдите @BotFather
#    2. Отправьте /newbot
#    3. Придумайте имя (например, «Cine Bot») и username (например, cine_link_bot)
#    4. BotFather пришлёт токен вида 123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
#
#  После создания бота:
#    1. Добавьте бота в целевой канал
#    2. Назначьте его администратором с правом «Post Messages»

BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11


# ------------------------------------------------------------
#  3. TMDB API KEY (Поиск фильмов и сериалов)
# ------------------------------------------------------------
#  Зачем: бот ищет названия фильмов в базе TMDb, получает
#         ссылки на TMDb, IMDb и Trakt.tv.
#
#  Как получить:
#    1. Зарегистрируйтесь на https://www.themoviedb.org
#    2. Перейдите в Settings → API: https://www.themoviedb.org/settings/api
#    3. Нажмите «Create» → «Developer»
#    4. Заполните форму (Application URL — можно http://localhost)
#    5. Скопируйте «API Key (v3 auth)» — это строка из 32 символов

TMDB_API_KEY=your_tmdb_api_key_here


# ------------------------------------------------------------
#  4. TARGET CHANNEL (Куда бот публикует результаты)
# ------------------------------------------------------------
#  Формат: username канала БЕЗ символа @ (например: my_movies)
#          или числовой ID канала (например: -1001234567890)
#
#  Требования:
#    - Канал уже должен существовать
#    - Бот (из п.2) должен быть админом этого канала

TARGET_CHANNEL=your_target_channel


# ------------------------------------------------------------
#  5. SOURCE CHANNELS (Откуда читать посты о кино)
# ------------------------------------------------------------
#  Формат: username каналов через запятую, БЕЗ символа @
#
#  Примеры:
#    SOURCE_CHANNELS=cinefiles_txt
#    SOURCE_CHANNELS=cinefiles_txt,kinomania,film_channel
#
#  Каналы должны быть публичными (или ваш аккаунт должен
#  быть на них подписан).

SOURCE_CHANNELS=cinefiles_txt
