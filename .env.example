# Telegram User API credentials
# Get from: https://my.telegram.org → API development tools
API_ID=12345678
API_HASH=your_api_hash_here

# Telegram Bot Token
# Get from: @BotFather in Telegram → /newbot
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# TMDb API Key (v3)
# Get from: https://www.themoviedb.org/settings/api → Create → Developer
TMDB_API_KEY=your_tmdb_api_key_here

# Target channel where bot posts messages (username without @ or numeric ID)
TARGET_CHANNEL=your_target_channel

# Source channels to monitor, comma-separated (usernames without @)
SOURCE_CHANNELS=cinefiles_txt
